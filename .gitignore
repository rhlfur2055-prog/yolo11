# ──────────────────────────────────────────────────────────────
# YOLO11 번호판 인식 — .gitignore
# 기준: GitHub Python 템플릿 + 프로젝트 산출물
# ──────────────────────────────────────────────────────────────

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# ── 가상환경 / 환경변수 ──
.venv/
venv/
env/
ENV/
.env

# ── IDE / 에디터 ──
.vscode/
.idea/
*.swp
*.swo

# ── 캐시 ──
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── OS ──
Thumbs.db
.DS_Store
nul

# ── 모델 / 바이너리 (Git LFS 또는 별도 배포) ──
*.pt
*.pth
*.onnx
*.onnx.bak
*.engine
*.exe
aihubshell

# ── 미디어 (테스트 영상/오디오) ──
*.mp4
*.avi
*.mkv
*.wav
*.mp3

# ── 데이터셋 (대용량/개인정보) ──
dataset/*
!dataset/yolo_format/
dataset/yolo_format/*
!dataset/yolo_format/data.yaml
aihub_data/
aihub_raw/
aihub_results/
103.*/
22/
movie/
runs/

# ── 산출물 / 임시 디렉터리 ──
output/
temp/
data/
logs/
plate_results*/
debug_crops/
preview_frames/
temp_youtube/
server_results/
uploads/
test_results/
_thumb/

# ── 산출 파일 ──
*.log
*.bak
*.zip
*.db
*.sqlite
*_dashboard_data.json
test_result_*.txt
gui_log.txt
gui_stdout.txt

# ── 디버그/스크린샷 임시 ──
debug_*.png
debug_*.jpg
_screenshot*.png
_test_*.png
_test_*.jpg
screenshot_*.png
gui_screenshot_*.png
test_realtime_*.png

# ── 외부 서비스 캐시 ──
.claude/
.paddleocr/
.paddlex/

# ── Docker / DB 초기화 ──
pgdata/
init-db/
